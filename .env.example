# 复制成 .env 后填。MCP server 从进程环境读，用 mcp.json 的 env 段注入也行。

# 自建 CLIProxyAPI 网关（填到根即可，工具会自己补 /v1/...）
HVC_BASE_URL=https://your-gateway.example.com
HVC_API_KEY=sk-xxx

# 视频通道单独一把 Key：中转把 /v1/videos/* 挂在独立鉴权分组，主 Key 打过去 403。
# 直连 xAI 的话把 HVC_VIDEO_BASE_URL 设成 https://api.x.ai/v1
HVC_GROK_KEY=xai-xxx
# HVC_VIDEO_BASE_URL=https://api.x.ai/v1

# 可选
# HVC_WORKSPACE=/Users/you/hotvideocopy/workspace
# HVC_IMAGE_MODEL=gpt-image-2
# HVC_VIDEO_MODEL=grok-imagine-video-1.5
# HVC_IMG_CONCURRENCY=1        # 出图并发，默认 1（串行最稳，上游对并发极敏感）
# HVC_PROXY=http://127.0.0.1:7890

# 转写（先 pip install -e '.[asr]'）
# HVC_WHISPER_MODEL=large-v3   # 嫌慢降 medium；中文短视频 large-v3 明显更准
# HF_TOKEN=hf_xxx              # pyannote 说话人分离用；模型是 gated，要在模型页接受协议

# TTS（走网关 /v1/audio/speech）
# HVC_TTS_MODEL=gpt-4o-mini-tts
# HVC_TTS_VOICE=alloy
